# Copy this file to .env for local development.
# Do not commit .env.
#
# SECRETS DO NOT BELONG HERE. API keys and tokens live in the OS credential store
# (Windows Credential Manager). Set them with:  secretsx set <NAME>
# See docs/SECRETS.md. This file is for non-secret config only.
#
# Secrets managed by `secretsx` (do not fill in here):
#   EXA_API_KEY, REF_API_KEY, FIGMA_TOKEN,
#   SLACK_BOT_TOKEN, ATLASSIAN_API_TOKEN,
#   REDDIT_CLIENT_ID, REDDIT_CLIENT_SECRET

# --- Non-secret config ---

# redditx request User-Agent (public Reddit JSON; no OAuth today)
REDDIT_USER_AGENT=agent-clis/0.1

# Path to a Google credentials file (a path, not a secret value)
GOOGLE_APPLICATION_CREDENTIALS=

# Atlassian non-secret config (the API token itself goes in the credential store)
ATLASSIAN_BASE_URL=
ATLASSIAN_EMAIL=
