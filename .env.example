# Copy this file to .env for local development.
# Do not commit .env.

# Planned searchx CLI
EXA_API_KEY=

# Ref-backed documentation lookup
REF_API_KEY=

# Figma read-only REST access (Figma > Settings > Security > Personal access tokens)
FIGMA_TOKEN=

# Planned future redditx OAuth mode. Current redditx uses public Reddit JSON only.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=agent-clis/0.1

# Planned Google tools
GOOGLE_APPLICATION_CREDENTIALS=

# Slack message reads. Prefer SLACK_USER_TOKEN when private-channel access should match the user.
SLACK_TOKEN=
SLACK_USER_TOKEN=
SLACK_BOT_TOKEN=

# Planned Atlassian tools
ATLASSIAN_BASE_URL=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
